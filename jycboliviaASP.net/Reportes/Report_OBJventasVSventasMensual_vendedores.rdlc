              <TextRun>
                <Value>Mes: </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Switch(
    Fields!mes.Value = 1, "Enero",
    Fields!mes.Value = 2, "Febrero",
    Fields!mes.Value = 3, "Marzo",
    Fields!mes.Value = 4, "Abril",
    Fields!mes.Value = 5, "Mayo",
    Fields!mes.Value = 6, "Junio",
    Fields!mes.Value = 7, "Julio",
    Fields!mes.Value = 8, "Agosto",
    Fields!mes.Value = 9, "Septiembre",
    Fields!mes.Value = 10, "Octubre",
    Fields!mes.Value = 11, "Noviembre",
    Fields!mes.Value = 12, "Diciembre"
)</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
